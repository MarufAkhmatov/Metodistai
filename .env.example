# AI Metodist Agent papkasiga to'liq yo'l.
# Bu papkada CLAUDE.md (Claude uchun yo'riqnoma) va metodologiya hujjatlari turishi kerak.
# Web saytdagi chat shu papkada Claude Code CLI ni ishga tushiradi — natijada
# Claude CLAUDE.md ni avtomatik o'qiydi va kerakli hujjatlarga qaray oladi.
METODIST_AGENT_DIR=C:\Users\ASUS\Desktop\AI Metodist Agent

# Backend port (default: 3001)
# PORT=3001

# Claude CLI binar nomi yoki to'liq yo'li (default: claude)
# CLAUDE_BIN=claude

# --- Autentifikatsiya (login sahifa) ---
# Saytga kirish uchun email.
AUTH_EMAIL=email@example.com

# Parolning bcrypt HASH'i (ochiq parol EMAS!).
# Yangi hash yaratish:  node server/hash-password.mjs "yangi-parol"
# Natijani qo'shtirnoq ichida shu yerga qo'ying.
AUTH_PASSWORD_HASH="bu_yerga_bcrypt_hash"

# JWT imzolash uchun maxfiy kalit — uzun, tasodifiy satr.
# Yangi kalit yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="bu_yerga_uzun_tasodifiy_satr"
